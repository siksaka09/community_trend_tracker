# ตัวอย่างไฟล์ secrets สำหรับ Streamlit Community Cloud
# ไม่ต้อง commit ไฟล์นี้ขึ้น GitHub — ใช้เป็นแบบตอนไปวางค่าจริงใน
# "Manage app" > "Settings" > "Secrets" ของแอปบนเว็บ share.streamlit.io เท่านั้น
#
# ถ้าจะรันในเครื่อง ให้ใช้ .env ตามเดิม (ไฟล์นี้มีผลเฉพาะตอนรันบน Streamlit Cloud)

ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxx"
APIFY_API_TOKEN = "apify_api_xxxxxxxxxxxxxxxx"
TWITTER_HANDLES = "EASPORTSFC,eafootball_news"
TWITTER_KEYWORDS = "FC27,FC 27,EAFC27,EA FC 27,EA Sports FC 27"
FILTER_BY_KEYWORD = "false"
TWITTER_RESULTS_LIMIT = "40"
