# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ
# คำสั่ง: cp .env.example .env

# ไปเอา token ได้ที่ https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# ไปเอา key ได้ที่ https://console.anthropic.com/settings/keys
# ต้องเติมเครดิตในบัญชี (งบ $5 เพียงพอสำหรับทดสอบและใช้งานได้หลายสิบรอบ เพราะวิเคราะห์เป็นแบท)
ANTHROPIC_API_KEY=your_anthropic_key_here

# บัญชี X (Twitter) ที่ต้องการติดตาม (ไม่ต้องมี @ นำหน้า) คั่นด้วย , เช่น เพจข่าวเกม,
# บัญชีทางการของ EA Sports FC, บัญชีผู้มีอิทธิพลในวงการที่มักพูดถึงเกมนี้
TWITTER_HANDLES=EASPORTSFC,eafootball_news

# จำนวนทวีตสูงสุดที่ดึงต่อบัญชีต่อรอบ
TWITTER_RESULTS_LIMIT=40

# ===== ตั้งค่าการกรอง (เลือกได้ 2 โหมด) =====
# false (ค่าเริ่มต้น) = ดึงทุกทวีตจากบัญชีข้างต้น แล้วให้ AI กรองว่าเกี่ยวกับ FC27 ทีหลัง
#   ครอบคลุมกว่า (ไม่พลาดทวีตที่พูดถึงเกมแบบอ้อมๆ) แต่เปลือง credit/token มากกว่าถ้าบัญชีนั้น
#   ทวีตเรื่องอื่นเยอะ
# true = กรองตั้งแต่ตอนดึงเลย โดยค้นหาเฉพาะทวีตจากบัญชีนั้นที่มีคีย์เวิร์ดตรงกับ TWITTER_KEYWORDS
#   ประหยัด credit/token กว่ามาก แต่เสี่ยงพลาดทวีตที่พูดถึงเกมแบบไม่ใช้คำตรงเป๊ะ (เช่น ใช้ตัวย่อแปลกๆ)
FILTER_BY_KEYWORD=false

# คีย์เวิร์ดที่ใช้กรอง (มีผลเฉพาะตอน FILTER_BY_KEYWORD=true) คั่นด้วย , ใส่หลายแบบเผื่อคนสะกดไม่เหมือนกัน
TWITTER_KEYWORDS=FC27,FC 27,EAFC27,EA FC 27,EA Sports FC 27

# ===== Reddit =====
# เปิด/ปิดแหล่งข้อมูล Reddit ทั้งหมด — ปิดไว้ = ข้ามขั้นตอนนี้ตอนรัน run_all.py หรือกดปุ่มในหน้า
# Pipeline โดยไม่ error แม้ยังไม่ได้ตั้งค่าอะไรด้านล่างเลย
ENABLE_REDDIT_SOURCE=true

# คีย์เวิร์ดค้นหาข้ามทั้ง Reddit (ไม่จำกัด subreddit) คั่นด้วย , ใส่หลายแบบเผื่อคนสะกดไม่เหมือนกัน
# เว้นว่างได้ถ้าอยากใช้แค่ REDDIT_SUBREDDITS แทน
REDDIT_SEARCH_TERMS=FC27,FC 27,EAFC27,EA FC 27,EA Sports FC 27

# subreddit ที่รู้จักอยู่แล้วว่าเกี่ยวข้อง (ไม่ต้องมี r/ นำหน้า) คั่นด้วย , เว้นว่างได้ถ้าไม่อยากระบุ
REDDIT_SUBREDDITS=EASportsFC,FIFA

# จำนวนโพสต์สูงสุดที่ดึงต่อคีย์เวิร์ด/ต่อ subreddit ต่อรอบ
REDDIT_RESULTS_LIMIT=40

# ===== Facebook Pages (เทียบราคา/โปรโมชั่นระหว่างเพจร้านค้า) =====
# ต่างจาก X/Reddit ตรงที่นี่คือติดตามเพจที่รู้จักตายตัว (เช่น เพจเราเอง + เพจคู่แข่ง)
# ใช้เทียบราคา/โปรโมชั่น/engagement ระหว่างเพจ ไม่ใช่ตามกระแส community กว้างๆ

# เปิด/ปิดแหล่งข้อมูล Facebook ทั้งหมด — ปิดไว้ = ข้ามขั้นตอนนี้ตอนรัน run_all.py หรือกดปุ่มในหน้า
# Pipeline โดยไม่ error แม้ยังไม่ได้ตั้งค่า FB_PAGE_URLS เลย
ENABLE_FACEBOOK_SOURCE=true

# URL เพจ Facebook ที่ต้องการติดตาม (ต้องเป็นเพจ public) คั่นด้วย , เช่น เพจเราเอง + เพจคู่แข่ง
FB_PAGE_URLS=https://www.facebook.com/yourpage,https://www.facebook.com/competitorpage

# จำนวนโพสต์สูงสุดที่ดึงต่อเพจต่อรอบ (แนะนำ 30-50 พอ ไม่งั้นจะกิน Apify credit เยอะ)
FB_POSTS_PER_PAGE=30
